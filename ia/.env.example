# Padrão mais simples: SQLite local (nenhum serviço adicional necessário)
DB_ENGINE=sqlite

# Para usar MySQL/MariaDB do XAMPP, altere DB_ENGINE para mysql e preencha:
# DB_ENGINE=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=ecocity_guardian
# MYSQL_USER=root
# MYSQL_PASSWORD=

# Opcional: se o Ollama estiver instalado, a API tenta utilizá-lo antes do fallback heurístico.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2

# Chave usada pelo sketch ESP32 (troque por um valor próprio antes de expor a API)
SENSOR_API_KEY=ecocity-iot-demo-key
